import MathLean.BinaryGramAutomaton
namespace MathLean.GramCount
set_option maxHeartbeats 0
set_option maxRecDepth 100000

inductive CountTree where
  | leaf (start : ℕ) (values : List ℤ)
  | branch (split : ℕ) (left right : CountTree)

def CountTree.get : CountTree → ℕ → ℤ
  | .leaf start values, i => values.getD (i-start) 0
  | .branch split left right, i => if i < split then left.get i else right.get i

