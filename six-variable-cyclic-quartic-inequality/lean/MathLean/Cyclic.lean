/-- Six-variable cyclic inequality, including arbitrary negative entries. -/
theorem cyclic_inequality (x0 x1 x2 x3 x4 x5 : ℝ) :
    (x0+x1+x2+x3+x4+x5) * (x0*x1^2+x1*x2^2+x2*x3^2+x3*x4^2+x4*x5^2+x5*x0^2)
      ≤ (x0^2+x1^2+x2^2+x3^2+x4^2+x5^2)^2 := by
  have h : 0 ≤ gap x0 x1 x2 x3 x4 x5 := by
    rw [sos_identity]
    positivity
  unfold gap at h
  linarith

theorem equality_iff (x0 x1 x2 x3 x4 x5 : ℝ) :
    gap x0 x1 x2 x3 x4 x5 = 0 ↔ x0 = x1 ∧ x1 = x2 ∧ x2 = x3 ∧ x3 = x4 ∧ x4 = x5 := by
  constructor
  · intro hz
    have h0 : 0 ≤ (1 / 18500 : ℝ) * (q0 x0 x1 x2 x3 x4 x5)^2 := by positivity
    have h1 : 0 ≤ (1 / 677636500 : ℝ) * (q1 x0 x1 x2 x3 x4 x5)^2 := by positivity
